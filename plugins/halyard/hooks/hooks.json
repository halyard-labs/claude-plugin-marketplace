{
  "description": "Orients sessions toward the team knowledge base, nudges capture of session outcomes, and uploads every session transcript to Halyard",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PLUGIN_ROOT/hooks/session-knowledge-context.sh",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "$CLAUDE_PLUGIN_ROOT/hooks/agent-session-upload.sh --event start",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PLUGIN_ROOT/hooks/user-prompt-knowledge-hint.sh",
            "timeout": 5
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PLUGIN_ROOT/hooks/search-first-nudge.sh",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PLUGIN_ROOT/hooks/stop-summarize-nudge.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PLUGIN_ROOT/hooks/agent-session-upload.sh --event end --detach",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
